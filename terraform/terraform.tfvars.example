# Copy to terraform.tfvars and fill in values.
# Never commit API tokens or access keys.

aws_profile  = "aws-mahesh"
aws_region   = "ap-south-1"
project_name = "animated-experience-portfolio"

# Site: https://mahesh.qishub.in
cloudflare_zone_name = "qishub.in"
site_subdomain       = "mahesh"

# Prefer: export TF_VAR_cloudflare_api_token="..."
# cloudflare_api_token = ""

# DNS-only (grey cloud) — required for CloudFront + ACM
cloudflare_proxied = false

# Fresh personal AWS account: Terraform creates the S3 bucket
existing_s3_bucket_name = ""

# Optional deploy IAM user (you can deploy with mahesh-aws profile instead)
create_deploy_user = false

price_class = "PriceClass_100"
